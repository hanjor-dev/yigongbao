# 医工宝本地开发环境变量模板
# 复制此文件为 .env，填入真实值，.env 不会提交到代码库
# 生产环境直接在服务器/容器中配置对应的系统环境变量，无需 .env 文件

# ==================== 数据库 ====================
DB_HOST=localhost
DB_PORT=3307
DB_NAME=yigongbao
DB_USERNAME=root
DB_PASSWORD=

# ==================== Redis ====================
REDIS_PASSWORD=

# ==================== 邮件 ====================
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ==================== 阿里云 OSS ====================
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=yigongbao-dev
OSS_DOMAIN=https://yigongbao-dev.oss-cn-hangzhou.aliyuncs.com/

# ==================== 系统安全（仅 prod 环境需要）====================
# DEFAULT_PASSWORD=
