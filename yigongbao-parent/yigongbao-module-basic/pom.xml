<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.yigongbao</groupId>
        <artifactId>yigongbao-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>yigongbao-module-basic</artifactId>

    <dependencies>
        <!-- common -->
        <dependency>
            <groupId>com.yigongbao</groupId>
            <artifactId>yigongbao-common</artifactId>
        </dependency>

        <!-- framework -->
        <dependency>
            <groupId>com.yigongbao</groupId>
            <artifactId>yigongbao-framework</artifactId>
        </dependency>

        <!-- 文件存储（版本由父 pom 统一管理） -->
        <dependency>
            <groupId>org.dromara.x-file-storage</groupId>
            <artifactId>x-file-storage-spring</artifactId>
        </dependency>

        <!-- Apache POI（版本由父 pom 统一管理） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
        </dependency>
        <!-- 阿里云 OSS SDK（可选，按需启用云存储） -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>3.17.4</version>
        </dependency>

        <!-- 测试依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
