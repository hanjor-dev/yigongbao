<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yigongbao.module.notification.announcement.mapper.AnnouncementTargetMapper">

    <sql id="activeUserColumns">
        SELECT u.id AS user_id,
               u.username AS username,
               u.real_name AS real_name,
               u.role_name AS role_name
        FROM sys_user u
        WHERE u.status = 1
          AND u.is_deleted = 0
    </sql>

    <select id="selectAllActiveUsers" resultType="com.yigongbao.module.notification.announcement.vo.AnnouncementTargetUserVO">
        <include refid="activeUserColumns"/>
        ORDER BY u.id
    </select>

    <select id="selectActiveUsersByRoleIds" resultType="com.yigongbao.module.notification.announcement.vo.AnnouncementTargetUserVO">
        <include refid="activeUserColumns"/>
        AND u.role_id IN
        <foreach collection="roleIds" item="roleId" open="(" separator="," close=")">
            #{roleId}
        </foreach>
        ORDER BY u.id
    </select>

    <select id="selectActiveUsersByIds" resultType="com.yigongbao.module.notification.announcement.vo.AnnouncementTargetUserVO">
        <include refid="activeUserColumns"/>
        AND u.id IN
        <foreach collection="userIds" item="userId" open="(" separator="," close=")">
            #{userId}
        </foreach>
        ORDER BY u.id
    </select>

    <select id="selectUserDisplayName" resultType="java.lang.String">
        SELECT COALESCE(NULLIF(real_name, ''), username)
        FROM sys_user
        WHERE id = #{userId} AND is_deleted = 0
        LIMIT 1
    </select>

</mapper>
