<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yigongbao.module.notification.announcement.mapper.SystemAnnouncementMapper">
    <select id="selectForUpdate" resultType="com.yigongbao.module.notification.announcement.entity.SystemAnnouncementEntity">
        SELECT * FROM system_announcement
        WHERE id = #{id} AND is_deleted = 0
        FOR UPDATE
    </select>
</mapper>
